#!/bin/bash

ROOT=/home/eltonzip/Programming/Bash/Meowm/test-root

if [ $# == 0 ]; then
	echo 'meowm-ins: pass the package name to install it.'
	exit 1
fi

package_name=$1.tar.gz

ls $ROOT/var/meowm/pkg/$package_name

if [ $? -ne 0 ]; then
	echo 'Package not found locally, remote download not implemented yet'
	exit 1
else
	read -p 'Package found locally, proceed with installation? [y/n] ' confirm

	if [ $confirm == y ]; then
		cp $ROOT/var/meowm/pkg/$package_name $ROOT/tmp/
		cd $ROOT/tmp
		pwd
		tar xfv $package_name
		cd $1
		pwd
		source .MEOWBLD
		cd $ROOT/tmp
		pwd
		rm -rf $package_name $1
	else
		exit 0
	fi
fi
