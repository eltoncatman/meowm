#!/bin/bash

ROOT=/home/eltonzip/Programming/Bash/Meowm/test-root

if [ $# == 0 ]; then
	echo 'meowm-add: pass the package name to install it.'
	exit 1
fi

package_name=$1.tar.gz

ls $ROOT/var/cache/meowm/pkg/$package_name

if [ $? -ne 0 ]; then
	echo 'Package not found locally, remote download not implemented yet'
	exit 1
else
	printf 'Package found locally\n\n'

	mkdir $ROOT/tmp/meowm
	cp $ROOT/var/cache/meowm/pkg/$package_name $ROOT/tmp/meowm/
	cd $ROOT/tmp/meowm
	tar xf $package_name
	cd $1
	source .MEOWBLD
	about
	read -p 'Proceed with installation? [y/n] ' confirm
	if [ $confirm == 'y' ]; then
		recipe
	fi
	cd $ROOT/tmp
	rm -rf meowm/
fi
