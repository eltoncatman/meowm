#!/bin/bash

ROOT=/home/eltonzip/Programming/Bash/Meowm/test-root

if [ $# == 0 ]; then
	echo 'meowm-rm: pass the package name to remove it.'
	exit 1
fi

ls $ROOT/var/lib/meowm/pkg/$1

if [ $? -ne 0 ]; then
	echo 'Package not found, not installed'
	exit 1
else
	read -p "Proceed with removing? [y/n] " confirm

	if [ $confirm == 'y' ]; then
		cat $ROOT/var/lib/meowm/pkg/$1 | xargs rm -rf
		rm $ROOT/var/lib/meowm/pkg/$1
	fi
fi
